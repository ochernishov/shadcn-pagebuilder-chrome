{
  "manifest_version": 3,
  "name": "__APP_NAME__",
  "version": "__APP_VERSION__",
  "key": "__EXTENSION_PUBLIC_KEY__",
  "description": "Collect web references and selected screenshots into implementation-ready page specifications.",
  "permissions": ["activeTab", "contextMenus", "storage", "unlimitedStorage", "sidePanel", "nativeMessaging", "commands", "scripting"],
  "optional_host_permissions": ["__CAPTURE_HOST_PERMISSION__"],
  "background": { "service_worker": "collector-worker.js", "type": "module" },
  "action": { "default_title": "Open __APP_NAME__" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "capture-block": {
      "description": "Capture the active page in Shadcn Page Collector",
      "suggested_key": { "default": "Alt+Shift+B", "mac": "Command+Shift+K" }
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
